#!/usr/bin/env bash
# prometeo: arranca, actualiza y revisa PROMETEO.
# Ejecuta `prometeo --help` para ver los comandos.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"
MODELS="$BACKEND/models"
KOKORO_URL="https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0"
BACK_PORT="${PROMETEO_PORT:-8765}"
FRONT_PORT="${PROMETEO_FRONT_PORT:-5173}"
BIN_LINK="$HOME/.local/bin/prometeo"

if [ -t 1 ]; then
  B=$'\e[1m'; D=$'\e[2m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; N=$'\e[0m'
else
  B=; D=; R=; G=; Y=; C=; N=
fi
say()  { printf '%s▸%s %s\n' "$C" "$N" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "Falta '$1' en el PATH."; }

usage() {
  cat <<EOF
${B}prometeo${N} — agente de voz local para planificar proyectos

${B}Uso:${N}
  prometeo [comando] [opciones]

${B}Comandos:${N}
  ${B}run${N}         Arranca backend (:$BACK_PORT) y frontend (:$FRONT_PORT). Es el comando por defecto.
                --open    abre el navegador al arrancar
  ${B}update${N}      Actualiza las dependencias del backend (uv) y del frontend (npm)
                --backend   solo el backend
                --frontend  solo el frontend
  ${B}models${N}      Descarga los modelos de voz Kokoro si faltan (--force para volver a bajarlos)
  ${B}build${N}       Compila el frontend para producción (frontend/dist)
  ${B}doctor${N}      Comprueba herramientas, modelos, dependencias y sesión de Claude
  ${B}install${N}     Enlaza este comando en $BIN_LINK
  ${B}uninstall${N}   Quita ese enlace
  ${B}path${N}        Muestra dónde está el repo de PROMETEO

${B}Opciones:${N}
  -h, --help     Muestra esta ayuda
  -v, --version  Muestra la versión

${B}Variables:${N}
  PROMETEO_PORT        puerto del backend  (por defecto 8765)
  PROMETEO_FRONT_PORT  puerto del frontend (por defecto 5173)
  Las demás (PROMETEO_MODEL, PROMETEO_ARCHITECT_MODEL…) están en el README.

${D}Repo: $ROOT${N}
EOF
}

version() {
  local v
  v="$(sed -n 's/^version = "\(.*\)"/\1/p' "$BACKEND/pyproject.toml" | head -1)"
  local rev
  rev="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')"
  echo "prometeo $v ($rev)"
}

ensure_models() {
  local force="${1:-}"
  if [ -n "$force" ] || [ ! -f "$MODELS/kokoro-v1.0.onnx" ] || [ ! -f "$MODELS/voices-v1.0.bin" ]; then
    need curl
    say "Descargando modelo de voz Kokoro (~350 MB)…"
    mkdir -p "$MODELS"
    curl -fL -o "$MODELS/kokoro-v1.0.onnx.part" "$KOKORO_URL/kokoro-v1.0.onnx"
    curl -fL -o "$MODELS/voices-v1.0.bin.part" "$KOKORO_URL/voices-v1.0.bin"
    mv "$MODELS/kokoro-v1.0.onnx.part" "$MODELS/kokoro-v1.0.onnx"
    mv "$MODELS/voices-v1.0.bin.part" "$MODELS/voices-v1.0.bin"
    ok "Modelos de voz listos."
  fi
}

cmd_run() {
  local open=
  for a in "$@"; do
    case "$a" in
      --open|-o) open=1 ;;
      *) die "Opción desconocida para run: $a" ;;
    esac
  done
  need uv; need npm
  unset ANTHROPIC_API_KEY   # usa tu suscripción de Claude (claude login), nunca una API key

  ensure_models
  [ -d "$FRONTEND/node_modules" ] || (cd "$FRONTEND" && npm install)

  (cd "$BACKEND" && exec uv run uvicorn app.main:app --port "$BACK_PORT" --log-level warning) &
  local back=$!
  trap "kill $back 2>/dev/null" EXIT

  if [ -n "$open" ]; then
    ( sleep 3; xdg-open "http://localhost:$FRONT_PORT" >/dev/null 2>&1 || true ) &
  fi
  cd "$FRONTEND"
  PROMETEO_BACKEND="${PROMETEO_BACKEND:-http://127.0.0.1:$BACK_PORT}" \
    npm run dev -- --port "$FRONT_PORT" --strictPort
}

# Versión instalada de un paquete en el venv del backend (vacío si no está).
pkg_version() {
  (cd "$BACKEND" && uv pip show "$1" 2>/dev/null | sed -n 's/^Version: //p')
}

update_backend() {
  need uv
  say "Backend: buscando versiones nuevas (uv lock --upgrade)…"
  # Los paquetes de GPU se instalan a mano con `uv pip install` y no están en el lock:
  # se anotan antes para reponerlos después.
  local had_ort_gpu had_cuda12
  had_ort_gpu="$(pkg_version onnxruntime-gpu)"
  had_cuda12="$(pkg_version nvidia-cublas-cu12)"

  (cd "$BACKEND" && uv lock --upgrade && uv sync --inexact)

  if [ -n "$had_cuda12" ]; then
    say "Backend: actualizando librerías CUDA 12 de Whisper…"
    (cd "$BACKEND" && uv pip install -U nvidia-cublas-cu12 "nvidia-cudnn-cu12>=9,<10")
  fi
  if [ -n "$had_ort_gpu" ]; then
    local ort
    ort="$(pkg_version onnxruntime)"
    if [ -n "$ort" ]; then
      say "Backend: reponiendo onnxruntime-gpu==$ort (Kokoro en GPU)…"
      (cd "$BACKEND" && uv pip install --reinstall-package onnxruntime-gpu "onnxruntime-gpu[cuda,cudnn]==$ort") \
        || warn "No hay onnxruntime-gpu $ort; Kokoro irá en CPU hasta que salga."
    fi
  fi
  ok "Backend actualizado."
}

update_frontend() {
  need npm
  say "Frontend: actualizando paquetes (npm update)…"
  (cd "$FRONTEND" && npm update)
  (cd "$FRONTEND" && npm outdated) || true   # lista lo que queda fuera de los rangos de package.json
  ok "Frontend actualizado."
}

cmd_update() {
  local back=1 front=1
  for a in "$@"; do
    case "$a" in
      --backend)  front= ;;
      --frontend) back= ;;
      *) die "Opción desconocida para update: $a" ;;
    esac
  done
  [ -n "$back" ]  && update_backend
  [ -n "$front" ] && update_frontend
  if git -C "$ROOT" diff --quiet -- backend/uv.lock frontend/package-lock.json 2>/dev/null; then
    ok "Todo estaba al día."
  else
    say "Han cambiado los locks:"
    git -C "$ROOT" diff --stat -- backend/uv.lock frontend/package-lock.json
    printf '%sRevisa que todo arranca (prometeo) antes de hacer commit.%s\n' "$D" "$N"
  fi
}

cmd_models() {
  case "${1:-}" in
    --force|-f) ensure_models force ;;
    "") ensure_models; ok "Modelos en $MODELS" ;;
    *) die "Opción desconocida para models: $1" ;;
  esac
}

cmd_build() {
  need npm
  [ -d "$FRONTEND/node_modules" ] || (cd "$FRONTEND" && npm install)
  (cd "$FRONTEND" && npm run build)
}

cmd_doctor() {
  local bad=0
  check() { if eval "$2" >/dev/null 2>&1; then ok "$1"; else warn "$1 — $3"; bad=1; fi; }
  check "uv"       "command -v uv"     "instálalo con: curl -LsSf https://astral.sh/uv/install.sh | sh"
  check "npm"      "command -v npm"    "instala Node (mise use -g node)"
  check "claude"   "command -v claude" "instala Claude Code"
  check "Sesión de Claude (claude login)" "[ -s \"\$HOME/.claude/.credentials.json\" ]" "ejecuta: claude login"
  check "Modelos Kokoro" "[ -f \"$MODELS/kokoro-v1.0.onnx\" ] && [ -f \"$MODELS/voices-v1.0.bin\" ]" "ejecuta: prometeo models"
  check "Dependencias del backend" "cd \"$BACKEND\" && uv sync --inexact --locked --dry-run" "ejecuta: cd backend && uv sync"
  check "Dependencias del frontend" "[ -d \"$FRONTEND/node_modules\" ]" "ejecuta: cd frontend && npm install"
  if [ -n "$(pkg_version onnxruntime-gpu)" ]; then
    local a b; a="$(pkg_version onnxruntime)"; b="$(pkg_version onnxruntime-gpu)"
    check "onnxruntime-gpu $b = onnxruntime $a" "[ \"$a\" = \"$b\" ]" "ejecuta: prometeo update --backend"
  fi
  local port
  for port in "$BACK_PORT" "$FRONT_PORT"; do
    if ss -ltn "sport = :$port" 2>/dev/null | grep -q LISTEN; then
      printf '%s·%s Puerto %s ocupado (¿PROMETEO ya arrancado?)\n' "$D" "$N" "$port"
    else
      ok "Puerto $port libre"
    fi
  done
  check "Comando en el PATH" "[ \"\$(readlink -f \"\$(command -v prometeo)\")\" = \"$ROOT/bin/prometeo\" ]" "ejecuta: $ROOT/bin/prometeo install"
  [ -n "${ANTHROPIC_API_KEY:-}" ] && warn "ANTHROPIC_API_KEY está definida: prometeo la ignora y usa tu suscripción."
  return $bad
}

cmd_install() {
  mkdir -p "$(dirname "$BIN_LINK")"
  ln -sfn "$ROOT/bin/prometeo" "$BIN_LINK"
  ok "Enlazado: $BIN_LINK → $ROOT/bin/prometeo"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) warn "~/.local/bin no está en tu PATH." ;;
  esac
}

cmd_uninstall() {
  if [ -L "$BIN_LINK" ]; then rm "$BIN_LINK"; ok "Quitado $BIN_LINK"; else warn "No hay enlace en $BIN_LINK"; fi
}

main() {
  local cmd="${1:-run}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    run|start)        cmd_run "$@" ;;
    --open|-o)        cmd_run "$cmd" "$@" ;;
    update|upgrade)   cmd_update "$@" ;;
    models)           cmd_models "$@" ;;
    build)            cmd_build "$@" ;;
    doctor)           cmd_doctor "$@" ;;
    install)          cmd_install ;;
    uninstall)        cmd_uninstall ;;
    path)             echo "$ROOT" ;;
    -h|--help|help)   usage ;;
    -v|--version|version) version ;;
    *) printf '%s✗%s Comando desconocido: %s\n\n' "$R" "$N" "$cmd" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
